{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SysAdminDoc/LogVerdict/blob/main/Data/error-codes.schema.json",
  "title": "LogVerdict typed Windows error catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "updated", "sources", "sourceHash", "entries"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "name": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notes": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "revision", "licence", "licenceHash"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "licence": { "const": "CC-BY-4.0" },
          "licenceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "hex", "name", "description", "explanation", "reference", "retrieved", "sourceHash", "applicability", "normalized", "sourceRepository", "sourcePath", "sourceRevision", "licence", "sourceDocumentHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[^\\s]+$" },
        "kind": { "enum": ["win32", "hresult", "bugcheck", "ntstatus", "setup", "windowsupdate"] },
        "code": { "type": ["integer", "string"] },
        "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "format": "uri" },
        "source": { "type": "string", "minLength": 1 },
        "sourceRepository": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "licence": { "const": "CC-BY-4.0" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sourceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "sourceDocumentHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "applicability": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "normalized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "hex", "unsigned", "signed", "code", "facility", "severity", "customer", "ntBit", "win32Code"],
          "properties": {
            "family": { "type": "string" },
            "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "unsigned": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "signed": { "type": "integer" },
            "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "facility": { "type": ["integer", "null"], "minimum": 0 },
            "severity": { "type": "string" },
            "customer": { "type": "boolean" },
            "ntBit": { "type": "boolean" },
            "win32Code": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }
          }
        }
      }
    }
  }
}
