{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LogVerdict offline advisory cache",
  "type": "object",
  "required": ["schemaVersion", "name", "updated", "source", "sourceHash", "freshness", "coverage", "advisories"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "required": ["name", "uri", "retrieved"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "freshness": {
      "type": "object",
      "required": ["maxCacheAgeDays", "maxSourceAgeDays", "dateBasis", "sourceDateField", "staleState", "unavailableState"],
      "properties": {
        "maxCacheAgeDays": { "type": "integer", "minimum": 1 },
        "maxSourceAgeDays": { "type": "integer", "minimum": 1 },
        "dateBasis": { "const": "UTC" },
        "sourceDateField": { "const": "modifiedDate" },
        "staleState": { "const": "stale" },
        "unavailableState": { "const": "unavailable" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["runtime", "tools"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["name", "supportedRange", "verifiedRuntimes", "verified", "source"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "supportedRange": { "type": "string", "minLength": 1 },
            "verifiedRuntimes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "source": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "version", "purpose", "verifiedRuntimes", "verified", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "verifiedRuntimes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "source": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "advisories": {
      "type": "array",
      "items": { "$ref": "#/definitions/advisory" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "advisory": {
      "type": "object",
      "required": ["id", "ecosystem", "package", "affectedRange", "fixedVersion", "cvss", "cvssVector", "kev", "publishedDate", "modifiedDate", "source", "sourceUri", "sourceHash", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "affectedRange": { "type": "string", "minLength": 1 },
        "fixedVersion": { "type": "string", "minLength": 1 },
        "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
        "cvssVector": { "type": "string", "minLength": 1 },
        "kev": { "type": "boolean" },
        "kevDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "publishedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "modifiedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": "string", "format": "uri" },
        "sourceHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
