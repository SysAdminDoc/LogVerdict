{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LogVerdict provider manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "entrypoint",
    "entrypointSha256",
    "capabilities",
    "permissions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?![\\\\/])(?!.:[\\\\/])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "entrypointSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "collect",
          "normalize",
          "coverage",
          "redaction",
          "fixtures",
          "reportProjection"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["read-only"] }
    },
    "fixtures": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?![\\\\/])(?!.:[\\\\/])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "reportProjection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          }
        }
      }
    }
  }
}
