{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SysAdminDoc/LogVerdict/blob/main/Data/report-contract.schema.json",
  "title": "LogVerdict versioned report contract",
  "type": "object",
  "required": ["Contract", "Tool", "Version", "ScanTime", "DaysBack", "Coverage", "Findings", "WorstVerdict", "ExitCode"],
  "properties": {
    "Contract": {
      "type": "object",
      "required": ["schemaVersion", "name", "mode", "generatedAt", "privacy", "compatibility"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "name": { "const": "LogVerdict.Report" },
        "mode": { "enum": ["live", "offline"] },
        "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "privacy": {
          "type": "object",
          "required": ["redacted", "rawEvidence", "statement"],
          "properties": {
            "redacted": { "type": "boolean" },
            "rawEvidence": { "type": "boolean" },
            "statement": { "type": "string" }
          }
        },
        "compatibility": {
          "type": "object",
          "required": ["readerMajor", "migration"],
          "properties": {
            "readerMajor": { "const": 1 },
            "migration": { "type": ["string", "null"] }
          }
        }
      }
    },
    "Tool": { "const": "LogVerdict" },
    "Version": { "type": "string" },
    "ScanTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "Duration": { "type": ["string", "null"], "pattern": "^P" },
    "DaysBack": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "Coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Source", "Kind", "Name", "Status", "ObservedRecords", "SkippedRecords"],
        "properties": {
          "Source": { "type": "string" },
          "Kind": { "type": "string" },
          "Name": { "type": "string" },
          "Status": { "type": "string" },
          "ObservedRecords": { "type": "integer", "minimum": 0 },
          "SkippedRecords": { "type": "integer", "minimum": 0 },
          "Reason": { "type": ["string", "null"] },
          "ParserError": { "type": ["string", "null"] },
          "SHA256": { "type": ["string", "null"] },
          "CollectionBudget": { "type": ["object", "null"] },
          "WindowStart": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "WindowEnd": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
        }
      }
    },
    "Findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "FirstSeen": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "LastSeen": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "BurstOnset": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "Times": { "type": "array", "items": { "type": "string", "format": "date-time", "pattern": "Z$" } }
        }
      }
    },
    "Incidents": {
      "type": "array",
      "description": "Rule-level reader-facing groups. Findings remains the signature-level compatibility layer.",
      "items": {
        "type": "object",
        "required": ["IncidentId", "RuleId", "Count", "SignatureCount", "SignatureKeys", "DistinctCodes"],
        "properties": {
          "IncidentId": { "type": "string" },
          "Grouping": { "enum": ["RuleId", "Signature"] },
          "RuleId": { "type": ["string", "null"] },
          "Count": { "type": "integer", "minimum": 0 },
          "CombinedCount": { "type": "integer", "minimum": 0 },
          "PerDay": { "type": "number", "minimum": 0 },
          "SignatureCount": { "type": "integer", "minimum": 1 },
          "SignatureKeys": { "type": "array", "items": { "type": "string" } },
          "DistinctCodes": { "type": "array", "items": { "type": "string" } },
          "ResultCodes": { "type": "array", "items": { "type": "string" } },
          "ExtendCodes": { "type": "array", "items": { "type": "string" } },
          "ErrorCodes": { "type": "array", "items": { "type": "string" } },
          "FirstSeen": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "LastSeen": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "Signatures": { "type": "array" },
          "ConstituentSignatures": { "type": "array" }
        }
      }
    },
    "IncidentSummary": {
      "type": "object",
      "required": ["SignatureCount", "IncidentCount", "SuppressedSignatureCount", "SuppressionRatio"],
      "properties": {
        "SignatureCount": { "type": "integer", "minimum": 0 },
        "IncidentCount": { "type": "integer", "minimum": 0 },
        "SuppressedSignatureCount": { "type": "integer", "minimum": 0 },
        "SuppressionRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "SuppressionPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "LowConfidenceSuppressedCount": { "type": "integer", "minimum": 0 },
    "Correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Start": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
                "End": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
              }
            }
          }
        }
      }
    },
    "HealthProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "OldestRecord": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
        }
      }
    },
    "Performance": { "type": "array" },
    "WorstVerdict": { "type": "string" },
    "ExitCode": { "type": "integer", "minimum": 0, "maximum": 4 }
  }
}
