{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SysAdminDoc/LogVerdict/blob/main/Data/review-artifact.schema.json",
  "title": "LogVerdict redacted review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "generatedAt", "tool", "version", "privacy", "run", "items", "import"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "const": "LogVerdict.ReviewArtifact" },
    "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "tool": { "const": "LogVerdict" },
    "version": { "type": "string" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted", "rawEvidence", "statement"],
      "properties": {
        "redacted": { "const": true },
        "rawEvidence": { "const": false },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "scanTime": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "confidence", "context", "evidence", "provenance", "falsePositives", "fixture", "review"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["unknown", "candidate"] },
          "status": { "const": "pending" },
          "confidence": { "type": "string" },
          "context": { "type": "object" },
          "evidence": { "type": "object" },
          "provenance": { "type": "object" },
          "falsePositives": { "type": "array", "items": { "type": "string" } },
          "candidate": { "type": "object" },
          "fixture": { "type": "object" },
          "contribution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "status", "rule", "evidence", "issue", "instruction"],
            "properties": {
              "label": { "type": "string", "pattern": "^Rule to write: .+" },
              "status": { "const": "test" },
              "instruction": { "type": "string", "minLength": 1 },
              "evidence": { "type": "object" },
              "issue": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "body"],
                "properties": {
                  "title": { "type": "string", "pattern": "^Rule to write: .+" },
                  "body": { "type": "string", "minLength": 1 }
                }
              },
              "rule": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "status", "match", "verdict", "title", "plain", "why", "action", "confidence", "sources"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
                  "status": { "const": "test" },
                  "match": { "type": "object" },
                  "verdict": { "const": "unknown" },
                  "title": { "type": "string", "pattern": "^Rule to write: .+" },
                  "plain": { "type": "string", "minLength": 1 },
                  "why": { "type": "string", "minLength": 1 },
                  "action": { "type": "string", "minLength": 1 },
                  "confidence": { "enum": ["low", "medium", "high"] },
                  "references": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
                  "falsepositives": { "type": "array", "items": { "type": "string" } },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uri", "retrieved"],
                      "properties": {
                        "uri": { "type": "string", "pattern": "^https?://" },
                        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                      }
                    }
                  }
                }
              }
            }
          },
          "review": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "enum": ["pending", "accepted", "rejected", "needs-evidence"] },
              "verdict": { "type": ["string", "null"] },
              "confidence": { "type": ["string", "null"] },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "import": { "type": "object" }
  }
}
