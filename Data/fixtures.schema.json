{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SysAdminDoc/LogVerdict/blob/main/Data/fixtures.schema.json",
  "title": "LogVerdict rule regression fixtures",
  "description": "Positive and near-miss signatures resolved through the real verdict engine. These fixtures are test data, not curated rulings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "updated", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notes": { "type": "string" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fixture" }
    }
  },
  "definitions": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "origin", "signature"],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["observed", "constructed"] },
        "expect": {
          "enum": ["benign", "informational", "unknown", "investigate", "actionable", "critical"]
        },
        "nearMiss": { "type": "boolean" },
        "perDay": { "type": "number", "minimum": 0 },
        "signature": { "$ref": "#/definitions/signature" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Source", "Channel", "Provider", "Id", "SampleMessage"],
      "properties": {
        "Source": { "enum": ["event", "textlog", "reliability"] },
        "Channel": { "type": "string", "minLength": 1 },
        "Provider": { "type": "string", "minLength": 1 },
        "Id": { "type": "integer", "minimum": 0 },
        "SampleMessage": { "type": "string", "minLength": 1 },
        "ResultCode": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "pattern": "^(-?[0-9]+|0[xX][0-9A-Fa-f]{1,8})$" }
          ]
        },
        "ExtendCode": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "pattern": "^(-?[0-9]+|0[xX][0-9A-Fa-f]{1,8})$" }
          ]
        },
        "ProviderLocale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$" },
        "StructuredData": { "type": "object" }
      }
    }
  }
}
