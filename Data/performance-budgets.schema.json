{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logverdict.local/schemas/performance-budgets.schema.json",
  "title": "LogVerdict content-free performance budgets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "units", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "units": { "const": "milliseconds" },
    "notes": { "type": "string" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceKind", "expectedStatus", "maxElapsedMilliseconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceKind": { "enum": ["text", "offline-evtx"] },
          "lineCount": { "type": "integer", "minimum": 1 },
          "errorEvery": { "type": "integer", "minimum": 1 },
          "malformedTimestamps": { "type": "boolean" },
          "byteCount": { "type": "integer", "minimum": 1 },
          "expectedStatus": { "type": "string", "minLength": 1 },
          "minObservedRecords": { "type": "integer", "minimum": 0 },
          "expectedUndatedRecords": { "type": "integer", "minimum": 0 },
          "maxParserMilliseconds": { "type": "integer", "minimum": 1 },
          "maxElapsedMilliseconds": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
